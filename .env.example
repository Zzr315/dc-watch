# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Task Scheduler does not inherit your interactive shell environment,
# so the daily job reads credentials from this file rather than from env vars.

# Required for backfill.py (free to create at openrouter.ai/settings/keys).
# Not needed for the daily run — the frontend rankings endpoint is unauthenticated.
OPENROUTER_API_KEY=

# Opus 5 commentary. This relay is LAN-only and is never written into the
# published HTML.
ANTHROPIC_BASE_URL=http://10.25.2.14:3000
ANTHROPIC_AUTH_TOKEN=

# Optional: Silicon Data GPU Index (paid Plus/Professional tier).
# Leave blank and the GPU panel renders a placeholder.
SD_TOKEN=
